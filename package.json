{
  "name": "labpulse-workspace",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "LabPulse - Laboratory Equipment Reliability and Maintenance Ledger for Academic Engineering Colleges",
  "scripts": {
    "build": "prisma generate && npm --prefix frontend run build",
    "postinstall": "npm --prefix frontend install",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "prisma:studio": "npm --prefix backend run prisma:studio"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
