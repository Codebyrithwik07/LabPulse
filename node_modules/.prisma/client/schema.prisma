generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LAB_STAFF
  LAB_ADMIN
}

enum Condition {
  OPERATIONAL
  DEGRADED
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultStatus {
  REPORTED
  ASSIGNED
  IN_REPAIR
  RESOLVED
  CLOSED
  REJECTED
}

enum RepairStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED_OPERATIONAL
  UNRESOLVED
}

enum CalibrationStatus {
  PASSED
  PASSED_WITH_ADJUSTMENTS
  FAILED
}

enum Category {
  OSCILLOSCOPE
  POWER_SUPPLY
  FUNCTION_GENERATOR
  MULTIMETER
  SPECTROPHOTOMETER
  CENTRIFUGE
  MICROSCOPE
  AUTOCLAVE
  CNC_MILL
  PRINTER_3D
  FURNACE
  ANALYTICAL_BALANCE
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  role       Role     @default(STUDENT)
  department String
  createdAt  DateTime @default(now())

  faultReports     FaultReport[]       @relation("ReportedBy")
  assignedRepairs  RepairRecord[]      @relation("AssignedTo")
  verifiedRepairs  RepairRecord[]      @relation("VerifiedBy")
  calibrations     CalibrationRecord[] @relation("PerformedBy")
  conditionChanges ConditionHistory[]  @relation("ChangedBy")
  supervisedLabs   Lab[]               @relation("LabSupervisor")

  @@map("users")
}

model Lab {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  building     String
  roomNumber   String
  supervisorId Int?
  supervisor   User?    @relation("LabSupervisor", fields: [supervisorId], references: [id])
  createdAt    DateTime @default(now())

  equipment Equipment[]

  @@map("labs")
}

model Equipment {
  id                       Int       @id @default(autoincrement())
  assetCode                String    @unique
  name                     String
  category                 Category
  modelNumber              String
  serialNumber             String    @unique
  manufacturer             String
  purchaseDate             DateTime
  warrantyExpiry           DateTime?
  currentCondition         Condition @default(OPERATIONAL)
  labId                    Int
  lab                      Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  calibrationFrequencyDays Int       @default(90)
  lastCalibratedAt         DateTime?
  nextCalibrationDue       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  faultReports       FaultReport[]
  repairRecords      RepairRecord[]
  calibrationRecords CalibrationRecord[]
  conditionHistories ConditionHistory[]

  @@index([labId])
  @@index([category])
  @@index([currentCondition])
  @@map("equipment")
}

model FaultReport {
  id           Int         @id @default(autoincrement())
  faultCode    String      @unique
  equipmentId  Int
  equipment    Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reportedById Int
  reportedBy   User        @relation("ReportedBy", fields: [reportedById], references: [id])
  title        String
  description  String
  severity     Severity    @default(MEDIUM)
  status       FaultStatus @default(REPORTED)
  reportedAt   DateTime    @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  repairRecords RepairRecord[]

  @@index([equipmentId])
  @@index([reportedById])
  @@index([severity])
  @@index([status])
  @@index([reportedAt])
  @@map("fault_reports")
}

model RepairRecord {
  id                 Int          @id @default(autoincrement())
  repairTicketNumber String       @unique
  equipmentId        Int
  equipment          Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  faultReportId      Int?
  faultReport        FaultReport? @relation(fields: [faultReportId], references: [id], onDelete: SetNull)
  assignedToId       Int?
  assignedTo         User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  actionTaken        String?
  partsReplaced      String?
  repairCost         Float        @default(0.0)
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  verifiedById       Int?
  verifiedBy         User?        @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  restorationStatus  RepairStatus @default(SCHEDULED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([equipmentId])
  @@index([faultReportId])
  @@index([assignedToId])
  @@index([restorationStatus])
  @@map("repair_records")
}

model CalibrationRecord {
  id                Int               @id @default(autoincrement())
  certificateNumber String            @unique
  equipmentId       Int
  equipment         Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedById     Int
  performedBy       User              @relation("PerformedBy", fields: [performedById], references: [id])
  calibrationDate   DateTime          @default(now())
  nextDueDate       DateTime
  standardUsed      String
  status            CalibrationStatus @default(PASSED)
  measurements      String?
  notes             String?
  createdAt         DateTime          @default(now())

  @@index([equipmentId])
  @@index([calibrationDate])
  @@index([nextDueDate])
  @@map("calibration_records")
}

model ConditionHistory {
  id                Int       @id @default(autoincrement())
  equipmentId       Int
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  changedById       Int?
  changedBy         User?     @relation("ChangedBy", fields: [changedById], references: [id])
  previousCondition Condition
  newCondition      Condition
  reason            String
  referenceType     String?
  referenceId       String?
  timestamp         DateTime  @default(now())

  @@index([equipmentId])
  @@index([timestamp])
  @@map("condition_history")
}
